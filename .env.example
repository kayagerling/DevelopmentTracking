# Kopieer dit bestand naar .env en vul het in.

# ── GitHub ──────────────────────────────────────────────
# Token met rechten: repo + read:project.
# Leeg laten = de server probeert `gh auth token` (lokaal, niet in Docker).
# Voor Docker: vul in met de uitvoer van `gh auth token`.
GITHUB_TOKEN=

# Eigenaar van het scrumboard (GitHub Project) en of dat een user of organization is.
GITHUB_OWNER=kayagerling
GITHUB_OWNER_TYPE=user
# Het nummer uit de URL van het project: github.com/users/<owner>/projects/<NUMMER>
GITHUB_PROJECT_NUMBER=

# Namen van de velden op het board
STATUS_FIELD=Status
THEME_FIELD=Thema
# Staat het thema niet als veld maar als label? Bijv. label "thema: Beveiliging"
THEME_LABEL_PREFIX=thema:

# Welk percentage hoort bij welke kolom (hoofdletters maken niet uit).
# STATUS_PROGRESS={"Backlog":0,"Todo":0,"Ready":10,"In progress":50,"In review":80,"Done":100}

# Afgevinkte taken (- [x]) in een PRD tellen mee in de voortgang
USE_CHECKLIST=true

# ── Versimpelen van beschrijvingen ─────────────────────
# Met een Anthropic API-key schrijft Claude per PRD een uitleg in gewone taal
# (één keer per wijziging, daarna uit de cache). Zonder key: automatische samenvatting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Overig ──────────────────────────────────────────────
PORT=3000
# Hoe vaak (in seconden) het dashboard ververst
REFRESH_SECONDS=60
# Forceer voorbeelddata
DEMO_MODE=false
